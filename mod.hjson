#the mod name as displayed in-game
displayName: "StarshinePlan"

#the internal name of your mod
name: "xx-mod"

#your name
author: "molo\nmullibenMolly"

#the fully qualified main class of the mod
main: "xx.xx"

#the mod description as seen in the mod dialog
description: "基本独立于原版内容，请勿与原版混用。\n没做兼容哦，崩了就别怪我啦。\n若是mod本身存在问题，请及时反馈给我，我会非常感谢你的！虽然没什么奖励就是了。\n没有华丽的制作团队，只有作者一人的挣扎..."

#the mod version
version: 0.0.3_v159.3

#the minimum game build required to run this mod
minGameVersion: 159.3

#this is a java mod
java: true

assets: [
    "bundles/"
    "content"
    "sprites/"
    "sounds/"
]


